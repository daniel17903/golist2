{
  "name": "@golist/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.sim.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sim": "vitest run --project sim",
    "test:unit": "vitest run --project unit",
    "test:sync-fuzz": "vitest run --config vitest.fuzz.config.ts"
  },
  "dependencies": {
    "@golist/shared": "0.1.0",
    "dexie": "^4.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.10.2",
    "globals": "^17.8.0",
    "playwright": "1.61.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=24.22.1"
  }
}
